---
interface Props {
  dataPage?: string;
}
const { dataPage = 'inicio' } = Astro.props;

const enlaces = [
  { href: '/', label: 'Inicio', key: 'inicio' },
  { href: '/disciplinas', label: 'Disciplinas', key: 'disciplinas' },
  { href: '/metodo', label: 'El método', key: 'metodo' },
];
---

<header class="topbar">
  <div class="container topbar__inner">
    <a href="/" class="brand" aria-label="Ir al inicio de Gestario Sport">
      <span aria-hidden="true">✏️</span>
      <span>Gestario <em>Sport</em></span>
    </a>
    <nav class="nav" aria-label="Navegación principal">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class:list={['nav__link', { 'nav__link--activo': dataPage === e.key }]}
          >
            {e.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>