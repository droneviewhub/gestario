---
import type { Disciplina, Ejercicio } from '../data/disciplinas';
import { COLORES } from '../data/colores';

interface Props {
  ejercicio: Ejercicio;
  disciplina: Disciplina;
}

const { ejercicio, disciplina } = Astro.props;
---

<div class="estudio" data-estudio>
  <!-- ===================== Panel de herramientas ===================== -->
  <aside class="estudio__panel">
    <!-- Herramienta -->
    <section>
      <h3 class="mb-2">Herramienta</h3>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" class="herramienta herramienta--activa" data-herramienta="lapiz" title="Lápiz">
          ✏️ Lápiz
        </button>
        <button type="button" class="herramienta" data-herramienta="marcador" title="Marcador">
          🖊️ Marcador
        </button>
        <button type="button" class="herramienta" data-herramienta="borrador" title="Borrador">
          🧽 Borrador
        </button>
      </div>
    </section>

    <!-- Color -->
    <section>
      <h3 class="mb-2">Color</h3>
      <div class="flex flex-wrap gap-2">
        {COLORES.map((c, i) => (
          <button
            type="button"
            class:list={['swatch', { 'swatch--activa': i === 0 }]}
            style={`background-color: ${c.hex}; border-color: ${c.hex === '#ffffff' ? '#cbd5e1' : c.hex}`}
            data-color={c.hex}
            aria-label={`Color ${c.nombre}`}
          ></button>
        ))}
      </div>
    </section>

    <!-- Grosor -->
    <section>
      <h3 class="mb-2">Grosor del trazo</h3>
      <div class="flex items-center gap-3">
        <input
          type="range"
          data-grosor
          min="1"
          max="32"
          value="4"
          class="h-2 flex-1 cursor-pointer appearance-none rounded-full bg-slate-200 accent-brand"
          aria-label="Grosor del trazo"
        />
        <output data-grosor-val class="w-8 text-center font-mono font-bold text-slate-700">4</output>
      </div>
    </section>

    <!-- Referencia -->
    <section>
      <h3 class="mb-2 flex items-center justify-between">
        Referencia
        <span class="flex items-center gap-2">
          <span class="text-[11px] font-bold text-slate-400 normal-case" data-ref-estado>visible</span>
          <button
            type="button"
            class="chip-estudio chip-estudio--activo"
            data-ref-toggle
            aria-pressed="true"
          >
            Ocultar
          </button>
        </span>
      </h3>
      <label class="mb-1 block text-xs font-semibold text-slate-500">Transparencia de la guía</label>
      <input
        type="range"
        data-ref-opacidad
        min="0"
        max="100"
        value="45"
        class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-brand"
        aria-label="Transparencia de la guía"
      />
    </section>

    <!-- Lienzo -->
    <section>
      <h3 class="mb-2">Lienzo</h3>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="chip-estudio" data-grid aria-pressed="false">⊞ Cuadrícula</button>
        <button type="button" class="chip-estudio" data-limpiar>🗑 Limpiar</button>
      </div>
    </section>

    <!-- Historial -->
    <section>
      <h3 class="mb-2">Historial</h3>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="chip-estudio" data-deshacer disabled>↩ Deshacer</button>
        <button type="button" class="chip-estudio" data-rehacer disabled>↪ Rehacer</button>
      </div>
    </section>

    <!-- Exportar -->
    <section class="mt-auto flex flex-col gap-2 border-t border-slate-200 pt-4">
      <button type="button" class="btn btn--primary w-full" data-exportar>
        ⬇️ Descargar dibujo (PNG)
      </button>
      <p class="text-center text-[11px] leading-relaxed text-slate-400">
        Tu dibujo se exporta con fondo blanco. La guía de referencia no se incluye.
      </p>
    </section>
  </aside>

  <!-- ===================== Zona de dibujo ===================== -->
  <div class="flex min-w-0 flex-1 flex-col gap-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <a
            href={`/disciplinas/${disciplina.slug}`}
            class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold tracking-wide uppercase hover:underline"
            style={`background: ${disciplina.color}18; color: ${disciplina.color}`}
          >
            {disciplina.icono} {disciplina.nombre}
          </a>
          <h1 class="font-display mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">
            {ejercicio.nombre}
          </h1>
          <p class="mt-1 text-sm text-slate-500">
            <strong class="text-ink">Objetivo:</strong> {ejercicio.objetivo}
          </p>
        </div>
        <div class="flex items-center gap-2 rounded-xl bg-brand-soft px-4 py-2 text-sm font-bold text-brand-600">
          ⏱️ {ejercicio.duracion} min
        </div>
      </div>

      <!-- Consigna -->
      <div class="mt-4 rounded-xl border border-dashed border-brand/40 bg-brand-soft/50 p-4">
        <p class="text-sm leading-relaxed text-ink">
          <strong class="text-brand-600">Tu tarea:</strong> {ejercicio.consigna}
        </p>
      </div>
    </div>

    <!-- Lienzo con referencia -->
    <div class="lienzo-marco" data-lienzo-marco>
      <img
        class="lienzo-referencia"
        src={disciplina.imagen}
        alt={`Referencia (placeholder) del ejercicio ${ejercicio.nombre}`}
        data-ref-img
        width="600"
        height="400"
      />
      <div class="grid-overlay absolute inset-0 hidden" data-grid-overlay aria-hidden="true"></div>
      <canvas class="lienzo-principal" data-lienzo data-archivo={ejercicio.slug} aria-label="Lienzo de dibujo"></canvas>
    </div>

    <!-- Consejo técnico -->
    <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <span class="text-2xl" aria-hidden="true">💡</span>
      <p class="text-sm leading-relaxed text-slate-600">
        <strong class="text-ink">Consejo técnico:</strong> {ejercicio.consejo}
      </p>
    </div>
  </div>
</div>

<script>
  import { montarLienzo } from '../scripts/lienzo';

  const raiz = document.querySelector('[data-estudio]');
  if (raiz) {
    const archivo = raiz.querySelector('[data-lienzo]')?.getAttribute('data-archivo') ?? 'dibujo';
    montarLienzo(raiz, archivo);
  }
</script>